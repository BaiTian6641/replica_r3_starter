  "declared_at_utc": "2026-10-27T00:00:00+00:00",
  "purpose": "A separately scoped, preparation-only co-adaptation control that may be considered only if the preserved lr 3e-05 smaller-step arm fails after a preserved diagnosis attributes the failure to frozen backbone features. It keeps the sealed MiniCPM5 parent, the same SigLIP2 encoder weights, the same prepared04 data, the same four-row update batch, the same response-only loss, the same lr 3e-05, the same five readout stages and the identical 4824-forward, 168-observation, 4-backward, 1-step, 1200-second, 33554432-byte envelope. Its only change is gradient scope: the last SigLIP2 encoder block and post-layernorm join the six projector tensors. It is not a retry, not an encoder swap, not a new loss, not a larger budget, and no native execution, authorization, development, held-out, V0, promotion or retry is authorized by this file.",
  "hypothesis": {
    "statement": "If the smaller-step failure is caused by projector-only adaptation over frozen visual features rather than by step size, then allowing the last SigLIP2 encoder block and post-layernorm to receive gradients at the identical lr 3e-05, loss, data, batch and budget should move the update-batch post-update mean response NLL toward its pre-update value or lower the wider train-fit loss, while encoder parameter drift stays inside the declared bounds.",
    "arm": "coadaptation",
    "changed_axis": "gradient_scope",
    "lr": 3e-05,
    "same_lr_as_smaller_step": true,
    "requires_diagnosed_smaller_step_failure": true,
    "frozen_feature_insufficiency_is_the_only_question": true,
    "not_a_step_size_test": true,
    "not_an_encoder_swap": true,
    "not_a_new_loss": true,
    "not_a_larger_budget": true,
    "rank_or_loss_movement_is_not_conversion": true
  },
