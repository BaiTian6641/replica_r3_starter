      "controls": [
        "shuffled_vision",
        "no_vision"
      ]
    },
    {
      "id": "G_GRADIENT",
      "criterion": "Finite intended gradients; exact-path numerical agreement; report approximation error and downstream effect for approximate methods"
    },
    {
      "id": "G_HARDWARE",
      "criterion": "Inherited resource bounds pass without silent fallback; full update and validation costs recorded"
    },
    {
      "id": "G_LEARNING_POLICY",
      "cycles": 10,
      "criterion": "Positive paired confidence interval over frozen-policy control on new tasks at matched compute, with retention passing"
    },
    {
      "id": "G_SLOT_IDENTITY",
      "criterion": "Permutation consistency within qualified numerical tolerance; zero stale identities in swap, batch, pending-input and restart tests; fallback on absent/full pinned sets"
    },
    {
      "id": "G_SWAP_RETENTION",
      "reactivation_accuracy_drop_max_percentage_points": 2,
      "resident_control_required": true,
      "absolute_lexical_gates_still_required": true
    },
    {
      "id": "G_SWAP_EFFICIENCY",
      "amortized_wall_time_benefit_min_percent": 5,
      "claim_scope": "Required to claim efficiency, not to claim useful bounded lexical functionality",
      "costs_include": [
        "selection",
        "fresh_encoding",
        "cold_starts",
        "cache_misses",
        "swaps",
        "persistence",
        "validation"
      ]
    }
