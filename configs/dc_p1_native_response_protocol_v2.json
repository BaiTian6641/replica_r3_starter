    {
      "amendment_id": "dc_p1_v2_a2_work_unit_correction",
      "kind": "corrected_unit",
      "silent": false,
      "old_limit_preserved": true,
      "reason": "v1 counted request == forward (forward_calls = 320 generation calls + 48 teaching forwards = 368) and ignored every decode forward, every no-cache processed position and the per-event durable writes. v2 counts execution points: model/tokenizer loads, training forwards, prefill forwards, decode forwards, autoregressive forwards, generated tokens, processed text positions including no-cache growth, backwards, optimizer steps, parity probes, every physical checkpoint write, recovery work and peak temporary storage.",
      "declared_work_added": {
        "counter": "all physical-work counters",
        "historical_forward_calls": 368,
        "historical_forward_calls_status": "incorrect_request_equals_forward_accounting",
        "historical_caps_reused": false
      },
      "affects_limits": true,
      "previous_limits": "budget.historical_v1.physical_limits",
      "new_limits": "budget.physical_limits",
      "not_a_silent_budget_raise": true
    },
    {
      "amendment_id": "dc_p1_v2_a3_staged_admission",
      "kind": "added_stage_admission",
      "silent": false,
      "old_limit_preserved": true,
      "reason": "v1 scored fit and development in one pass and had no admission gate. v2 makes fit, development and final separate processes and separate scoring entry points with independently sealed, digest-checked, tokenizer-backed receipts; development generation and labels stay closed until fit admission, and final teaching/generation/labels stay closed until development admission.",
      "declared_work_added": {
        "native_stage_processes": 3,
        "scoring_processes": 3,
        "model_loads": 3,
        "tokenizer_loads": 3,
        "scoring_tokenizer_loads": 3
      },
      "affects_limits": true,
      "previous_limits": "budget.historical_v1.physical_limits",
      "new_limits": "budget.physical_limits and budget.processes",
      "not_a_silent_budget_raise": true
    },
    {
      "amendment_id": "dc_p1_v2_a4_temporal_semantics",
      "kind": "semantic_correction",
      "silent": false,
      "old_limit_preserved": true,
      "reason": "v1's paraphrase role asked for the pre-correction value with an ordinary prompt after the correction had been taught, so the fixture implicitly rewarded a stale value. v2 binds every teaching row to an explicit event position and checkpoint identity, resolves ordinary queries at their query epoch (post_correction_current resolves the corrected value) and requires historical queries to name the historical event in the prompt (historical_state).",
      "declared_work_added": {
        "teaching_rows_rewritten": 48,
        "evaluation_cases_rewritten": 80,
        "case_count_change": 0,
        "generation_request_change": 0
      },
      "affects_limits": false,
      "previous_limits": "data/dc_p1_native_response_20261027 (unchanged)",
      "new_limits": "data/dc_p1_native_response_v2_20261027",
      "not_a_silent_budget_raise": true
    },
    {
      "amendment_id": "dc_p1_v2_a5_objective_audit",
      "kind": "declared_claim_narrowing",
      "silent": false,
      "old_limit_preserved": true,
      "reason": "The v2 teaching response is the answer tokens followed by the terminal EOS, so the answer-span-plus-EOS mask coincides with the full-response mask. The mandatory audit therefore declares the treatment objective a global CE rescale of the identical full-response CE (factor 1 + weight) and the span-specific claim is narrowed away instead of being asserted. A run whose audit disagrees refuses admission.",
      "declared_work_added": {
        "audit_rows": 48,
        "extra_generation_requests": 0,
        "extra_optimizer_steps": 0
      },
      "affects_limits": false,
      "previous_limits": "v1 hypothesis DC-P1-H1 primary change description",
      "new_limits": "objective.narrowed_claim",
      "not_a_silent_budget_raise": true
    },
    {
      "amendment_id": "dc_p1_v2_a6_final_scope",
      "kind": "final_stage_scope",
      "silent": false,
      "old_limit_preserved": true,
      "reason": "The sealed final stage stays treatment-only with 12 updates and 20 cases, and it is confirmation evidence only. It is not a 0.5-versus-0.0 comparison: the matched control is development-only, so no final-stage 0.5-vs-0.0 contrast is computed or reported.",
      "declared_work_added": {
        "final_optimizer_steps": 12,
        "final_generation_requests": 32,
        "final_checkpoint_artifacts": 1,
        "final_checkpoint_writes": 12
      },
      "affects_limits": false,
