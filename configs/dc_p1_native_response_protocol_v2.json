  "hypothesis": {
    "id": "DC-P1-H1-v2",
    "supersedes_hypothesis": "DC-P1-H1",
    "statement": "With the parent checkpoint, teaching rows, optimizer, seed and one-clock budget held fixed, a source-free generated-answer gain on post-correction ordinary paraphrases and new instances appears for the trained arms over the identical no-update arm and the reset-P arm, and the treatment is compared against a matched trained arm that runs the same objective with answer_span_ce_weight 0.0.",
    "refinement": "v2 adds the matched trained control and separates post-correction current queries from explicit historical queries. Because the masks coincide, the treatment objective is a declared global CE rescale of the matched objective, so the treatment-versus-matched contrast isolates optimisation-scale effects and is not reported as span-specific learning.",
    "primary_evidence": "Fresh post-correction paraphrase and new-instance exact generated-answer accuracy, paired by source group, measured source-free, against matched_trained, no_update and reset_P.",
    "excluded_claims": [
      "span-specific loss-shaping as the cause of any gain under coincident masks",
      "open-ended general capability",
      "learned retrieval or a learned router",
      "persistent learning across processes",
      "promotion of any checkpoint",
      "unaffected-skill retention beyond the declared synthetic probes",
      "budget02 revival or any two-step-per-event recipe",
      "a final-stage 0.5-versus-0.0 comparison"
    ]
  },
