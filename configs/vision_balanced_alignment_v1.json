      "dev": ["row_major_shift"],
      "audit": ["column_major_shift"]
    }
  },
  "selection": {
    "answer_class": "task_and_answer",
    "caption_class": "visible_object_count",
    "train_answers_per_class": 2,
    "train_captions_per_class": 3,
    "dev_answers_per_class": 3,
    "dev_captions_per_class": 2,
    "heldout_answers_per_class": 2,
    "heldout_captions_per_class": 2,
    "control_seed_offset": 7919,
    "require_semantic_counterfactual": true,
    "require_role_case_disjointness": true,
    "exclude_prior_evaluation_hashes": true,
    "max_visible_objects": 6
