  "train": {
    "seed": 17,
    "init_seed": 17,
    "init_recipe": "fresh_seeded_normal_std0.02",
    "optimizer": "adamw_fused",
    "optimizer_class": "torch.optim.AdamW",
    "fused": true,
    "lr": 0.0001,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-08,
    "max_grad_norm": 1.0,
    "max_seconds": 1800,
    "response_only_labels": true,
