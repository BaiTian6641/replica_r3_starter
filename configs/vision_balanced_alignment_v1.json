    ]
  },
  "schedule": {
    "alignment": {
      "updates": 10,
      "batch": 6,
      "caption_per_batch": 3,
      "answer_per_batch": 3,
      "policy": "deterministic_epoch_cycle",
      "role": "balanced caption and answer projector alignment overfit probe"
    }
  },
  "evaluation": {
    "dev_answer_controls": ["correct", "wrong", "shuffled", "noimage"],
    "heldout_answer_controls": ["correct", "wrong", "counterfactual", "shuffled", "noimage"],
    "caption_controls": ["correct", "counterfactual", "shuffled", "noimage"],
    "train_probe_controls": ["correct"],
    "question_template": "Question: {question}\nReply briefly with the answer alone.",
    "caption_question": "Describe the image briefly.",
    "counterfactual_policy": "sealed sibling image from the same procedural pair; for answer tasks the sibling answer differs by construction; answerable-only margin because abstain has no answer-changing counterfactual",
    "caption_dependence_policy": "correct image is compared with its semantically different sibling image, a deterministic shuffled donor and no image; teacher-forced loss and generated descriptor agreement are kept separate",
    "audit_policy": "held-out cases and labels are not read during training; scored once after the alignment extension is exported; a fresh-process reload must reproduce the same raw generations bitwise",
    "min_correct_accuracy": 0.5,
    "min_margin_wrong": 0.1,
    "min_margin_shuffled": 0.1,
    "min_margin_noimage": 0.15,
    "min_counterfactual_margin_answerable": 0.1,
    "min_caption_token_f1": 0.2,
    "min_caption_semantic_descriptor_f1": 0.5,
    "min_caption_dependence_f1_margin": 0.1,
    "min_caption_dependence_loss_margin": 0.1,
    "min_unknown_accuracy": 0.5,
    "max_false_answer_on_abstain": 0.5,
    "max_false_abstention_on_answerable": 0.5,
    "bootstrap": {
      "cluster": "world",
      "confidence": 0.95,
      "resamples": 1000
    },
    "gates_scope": "diagnostic only; failures are reported verbatim and never trigger promotion",
    "semantic_metric": "descriptor_multiset_precision_recall_f1_from_generated_caption_against_verifier_scene",
    "caption_metric": "normalized_token_f1_and_response_mean_nll"
  },
  "limits": {
    "max_updates": 10,
    "max_eval_cases": 240,
    "max_new_tokens": 8,
    "caption_max_new_tokens": 32,
    "max_prompt_tokens": 256,
