# Local model sources, experiments and private data stay on disk, outside Git.
/checkpoints/
/models/
/runs/
/private/
/data/raw/
/data/processed/

# Model weights, optimizer/runtime state, compiled inference and binary datasets.
*.safetensors
*.pt
*.pth
*.ckpt
*.gguf
*.ggml
*.onnx
*.mlmodel
*.mlpackage/
*.mlmodelc/
pytorch_model*.bin
adapter_model*.bin
optimizer*.bin
training_args.bin
*.weights
*.h5
*.hdf5
*.npy
*.npz
*.arrow
*.parquet

# Environments, caches and generated package output.
.venv*/
.cache/
.hf_cache/
.uv-cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Local databases and credentials. Keep the sample environment file shareable.
*.sqlite*
.env
.env.*
!.env.example
.DS_Store

# E3 fixture host scratch (created by FixtureWorkspace).
fixtures/e3/cases/*/.host_tmp/
