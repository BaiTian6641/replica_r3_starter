  "audit_source": "\nfrom pathlib import Path\nimport json, hashlib\nfrom replica_lab.memory_diagnosis import score_diagnostic, verify_prepared, _restart_readout_parity\nfrom replica_lab.runtime.persistent_fast_memory import read_persistent_manifest\nrun=Path('runs/memory_storage_probe_20261025/native01')\nreport=json.loads((run/'run_report.json').read_text())\nprotocol=json.loads(Path('data/memory_storage_probe_20261025/prepared01/protocol.json').read_text())\nverify_prepared(Path('data/memory_storage_probe_20261025/prepared01'))\nrows=[json.loads(line) for line in (run/'readouts.jsonl').read_text().splitlines()]\nbooks=json.loads((run/'codebooks.json').read_text())['codebooks']\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nassert sha(run/'readouts.jsonl')==report['readouts_sha256']\nassert sha(run/'codebooks.json')==report['codebooks_sha256']\nassert len(rows)==protocol['planned_workload']['total_planned_rows']==552\nafter=[row for row in rows if row['phase']=='after_reload']\nassert len(after)==276\nparity=[]\nfor world,stage in sorted({(row['world_id'],row['stage']) for row in rows}):\n    subset=[row for row in rows if(row['world_id'],row['stage'])==(world,stage)]\n    before=[row for row in subset if row['phase']=='before_reload']\n    later=[row for row in subset if row['phase']=='after_reload']\n    parity.append(_restart_readout_parity(before,later))\nassert all(item['equal'] for item in parity)\nmechanical={name:report[name] for name in ('frozen','correction','revocation','source_binding','restart')}\nscore=score_diagnostic(after,books,thresholds=protocol['thresholds'],mechanical=mechanical)\nassert score['summary']==report['summary'] and score['gates']==report['gates'] and score['decision']==report['decision']\nmanifests=[path.parent for path in (run/'images').rglob('persistent_manifest.json')]\nfor path in manifests:read_persistent_manifest(path)\nprint(json.dumps({'format':'replica.memory_storage_independent_score.v1','native_report_sha256':sha(run/'run_report.json'),'data_sha256':sha('data/memory_storage_probe_20261025/prepared01/data.json'),'protocol_sha256':sha('data/memory_storage_probe_20261025/prepared01/protocol.json'),'independent_rescore':'matched','evaluated_rows':len(rows),'unique_after_reload_cases':len(after),'restart_state_images_authenticated':len(manifests),'restart_raw_parity_sets':len(parity),'optimizer_updates':report['optimizer_updates'],'parameters_updated':report['parameters_updated'],**score}))\n",
  "audit_source_sha256": "ad06953a5698b76ad9903002628eb39031966b5213f228f55230baa2f4049567"
