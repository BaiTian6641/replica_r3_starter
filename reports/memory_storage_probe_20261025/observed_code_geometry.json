  "analysis_source": "\nfrom pathlib import Path\nimport hashlib,json\nimport torch\nfrom replica_lab.memory_diagnosis import _cosine_heads\nrun=Path('runs/memory_storage_probe_20261025/native01')\nbooks=json.loads((run/'codebooks.json').read_text())['codebooks']\nrows=[json.loads(line) for line in (run/'readouts.jsonl').read_text().splitlines()]\nrows=[row for row in rows if row['phase']=='after_reload' and row['status']=='ok']\nthresholds=json.loads(Path('data/memory_storage_probe_20261025/prepared01/protocol.json').read_text())['thresholds']\ngeometry=[]\ncentroids={}\nfor key,cb in sorted(books.items()):\n    values={eid:torch.tensor(e['value_vector'],dtype=torch.float32) for eid,e in cb['entries'].items()}\n    stacked=torch.stack(list(values.values()))\n    center=stacked.mean(0);centroids[key]=center\n    pairwise=[_cosine_heads(a,b) for i,a in enumerate(values.values()) for j,b in enumerate(values.values()) if i<j]\n    ideal=[]\n    for eid,value in values.items():\n        similarities=sorted([(_cosine_heads(value,other),other_id) for other_id,other in values.items()],reverse=True)\n        margin=similarities[0][0]-similarities[1][0] if len(similarities)>1 else None\n        accepted=similarities[0][1]==eid and margin is not None and margin>=thresholds['match_margin_floor']\n        ideal.append({'entry_id':eid,'ideal_margin':margin,'ideal_confident_recovery':accepted})\n    geometry.append({'codebook':key,'world':cb['world_id'],'stage':cb['stage'],'live_values':len(values),'pairwise_cosine_mean':sum(pairwise)/len(pairwise),'pairwise_cosine_min':min(pairwise),'pairwise_cosine_max':max(pairwise),'centroid_energy_fraction':float(center.square().sum()/stacked.square().sum((1,2)).mean()),'ideal_value_oracle':ideal})\ncounts={}\nfor row in rows:\n    if row['query_kind'] not in ('observed_write_key','canonical_address','canonical_paraphrase','native_reader'):continue\n    cb=books[row['codebook_key']];center=centroids[row['codebook_key']]\n    readout=torch.tensor(row['readout'],dtype=torch.float32)\n    candidates={eid:torch.tensor(e['value_vector'],dtype=torch.float32) for eid,e in cb['entries'].items()}\n    if cb['entries'][row['target_entry_id']]['role']=='correction_target':\n        candidates.update({eid:torch.tensor(e['value_vector'],dtype=torch.float32) for eid,e in cb.get('negative_entries',{}).items()})\n    raw=max(candidates,key=lambda eid:_cosine_heads(readout,candidates[eid]))\n    centered=max(candidates,key=lambda eid:_cosine_heads(readout-center,candidates[eid]-center))\n    bucket=counts.setdefault(row['query_kind'],{'n':0,'raw_top1':0,'centered_top1':0})\n    bucket['n']+=1;bucket['raw_top1']+=raw==row['target_entry_id'];bucket['centered_top1']+=centered==row['target_entry_id']\nideal=[item for entry in geometry for item in entry['ideal_value_oracle']]\nprint(json.dumps({'format':'replica.memory_observed_code_geometry.v1','scope':'retrospective CPU analysis only; no memory/model changes; original native protocol/rejection unchanged','gates_unchanged':True,'value_codebook_count':len(geometry),'geometry':geometry,'ideal_observed_value_oracle':{'accepted':sum(x['ideal_confident_recovery'] for x in ideal),'n':len(ideal),'declared_margin_floor':thresholds['match_margin_floor']},'centered_readout_counterfactual':counts,'neural_promotion':False,'pointer_copy_comparator':'not_admitted_storage_recovery_failed'}))\n"
}
